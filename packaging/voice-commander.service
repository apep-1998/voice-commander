[Unit]
Description=voice-commander push-to-talk daemon
Documentation=https://github.com/apep-1998/voice-commander
# The daemon needs the audio session, so it belongs to the graphical session rather than to
# login. Starting before PipeWire means opening a device that is not there yet.
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
# systemd wants an absolute path, and %h expands to the user's home. This copy is for a
# manual install into ~/.local/bin; install.sh rewrites it for any other prefix, and the
# PKGBUILD rewrites it to /usr/bin.
ExecStart=%h/.local/bin/voice-commanderd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# Logs go to the journal. The daemon detects this and drops its own timestamps so lines do
# not carry two of them.
StandardOutput=journal
StandardError=journal

# Deliberately lightly sandboxed.
#
# This daemon exists to run commands the user wrote — a script that files a recording in
# Dropbox, a callback that appends to ~/notes/voice/2026-09-11.md, a local Whisper binary
# reading a model from /opt. Filesystem confinement does not harden that, it breaks it:
# ProtectHome=read-only stops the `file` callback writing a journal entry, and PrivateTmp
# hides anything a callback leaves in /tmp from the user who went looking for it.
#
# What is kept is what costs nothing: it has no business gaining privileges, writing to
# system configuration, or touching kernel tunables.
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=false

[Install]
WantedBy=graphical-session.target
