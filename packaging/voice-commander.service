[Unit]
Description=voice-commander push-to-talk daemon
Documentation=https://github.com/apep-1998/voice-commander
# The daemon needs the audio session, so it belongs to the graphical session rather than to
# login. Starting before PipeWire means opening a device that is not there yet.
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/voice-commanderd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# Logs go to the journal. The daemon detects this and drops its own timestamps so lines do
# not carry two of them.
StandardOutput=journal
StandardError=journal

# It records audio and runs user-defined commands, so it is not a candidate for heavy
# sandboxing — but it has no business gaining privileges or writing outside the user's tree.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/voice-commander %h/.config/voice-commander
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=graphical-session.target
